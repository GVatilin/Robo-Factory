# Скопируйте в .env и при необходимости измените. Без .env используются значения по умолчанию из docker-compose.yml.

POSTGRES_USER=robo
POSTGRES_PASSWORD=robo
POSTGRES_DB=robofactory

# Обязательно замените при размещении в сети.
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

FRONTEND_PORT=8080
BACKEND_PORT=8000
# 5433, чтобы не конфликтовать с локально установленным PostgreSQL.
DB_PORT=5433

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Заполнение справочников, каталога и демо-данных при старте backend (идемпотентно).
SEED_ON_STARTUP=true

DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin12345
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=user12345
DEMO_VENDOR_EMAIL=vendor@example.com
DEMO_VENDOR_PASSWORD=vendor12345
